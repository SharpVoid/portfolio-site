---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import doverieHero from '../../assets/projects/doverie-hero.png';
import doverieAbout from '../../assets/projects/doverie-about.png';
import doverieProblem from '../../assets/projects/doverie-problem.png';
import doverieResult from '../../assets/projects/doverie-result.png';

interface Stage {
  id: string;
  title: string;
  image: ImageMetadata;
  alt: string;
  paragraphs: string[];
  meta?: { term: string; value: string }[];
}

const stages: Stage[] = [
  {
    id: 'about',
    title: 'О проекте',
    image: doverieAbout,
    alt: 'Главный экран банка «Доверие» над раскрытыми ладонями',
    paragraphs: [
      'Проект был разработан в рамках магистерской диссертации. Я самостоятельно сформулировал продуктовую гипотезу, разработал архитектуру социального слоя с учётом технических и юридических ограничений, спроектировал пользовательские сценарии и интерфейсы, собрал интерактивный прототип и обсудил концепцию с пользователями банковских приложений.',
    ],
    meta: [
      { term: 'Моя роль', value: 'продуктовый дизайнер и исследователь' },
      { term: 'Формат', value: 'самостоятельный магистерский проект' },
      { term: 'Зона ответственности', value: 'продуктовая концепция, архитектура, сценарии, UI и прототипирование' },
    ],
  },
  {
    id: 'problem',
    title: 'Проблема',
    image: doverieProblem,
    alt: 'Профиль пользователя банка «Доверие» с балансом, наградами и историей операций',
    paragraphs: [
      'При совместных расходах людям приходится постоянно переключаться между банковским приложением и мессенджерами.',
      'В одном месте они договариваются о суммах и участниках, в другом переводят деньги, а затем вручную проверяют, кто уже заплатил.',
      'Сам перевод выполняется быстро, но весь процесс вокруг него остаётся разрозненным. Добавление удобства должно логично встраиваться в уже существующий банковский интерфейс, не перегружая его базовые функции и не превращая приложение в super-app.',
    ],
  },
  {
    id: 'result',
    title: 'Результат',
    image: doverieResult,
    alt: 'Прототип банка «Доверие» с основными финансовыми сценариями над раскрытыми ладонями',
    paragraphs: [
      'Я разработал архитектуру социального слоя и интерактивный прототип, объединяющий доверительные связи, совместные расходы и переводы поблизости. Следующим этапом проекта стало бы сценарное usability-тестирование. Это позволило бы проверить не только отношение к идее, но и понятность конкретных действий в интерфейсе.',
    ],
  },
];
---

<BaseLayout
  title="«Доверие» — социальные сценарии в банковском приложении"
  description="Кейс продуктового дизайна банковского приложения с социальными сценариями"
>
  <main class="case-page">
    <header class="case-hero case-shell">
      <div class="case-hero__media">
        <Image
          src={doverieHero}
          alt="Главный экран банка «Доверие» на фоне мягкого голубого градиента"
          widths={[640, 960, 1322, 2080]}
          sizes="(max-width: 600px) calc(100vw - 32px), (max-width: 1024px) calc(100vw - 60px), 1322px"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="case-hero__copy">
        <h1>«Доверие»: социальные сценарии в банковском приложении</h1>
        <p>Идея создания социального слоя для банковского приложения, в которой объединяются финансовые операции и взаимодействие между знакомыми людьми.</p>
      </div>
    </header>

    <section class="case-story case-shell" data-case-story aria-label="Кратко о проекте">
      <div class="case-story__copy">
        {stages.map((stage, index) => (
          <article
            class:list={['case-stage', { 'is-active': index === 0 }]}
            data-case-stage={stage.id}
          >
            <span
              class:list={['case-stage__observer-target', { 'is-delayed': index > 0 }]}
              data-case-trigger
              aria-hidden="true"
            ></span>

            <div class="case-stage__content">
              <h2>{stage.title}</h2>

              <div class="case-stage__body">
                {stage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

                {stage.meta && (
                  <dl>
                    {stage.meta.map((item) => (
                      <div>
                        <dt>{item.term}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            </div>

            <div class="case-stage__mobile-visual" data-stage-image={stage.id}>
              <Image src={stage.image} alt={stage.alt} quality={88} loading="lazy" />
            </div>
          </article>
        ))}
      </div>

      <div class="case-story__visual" aria-hidden="true">
        {stages.map((stage, index) => (
          <Image
            class="case-story__image"
            src={stage.image}
            alt=""
            quality={90}
            loading={index === 0 ? 'eager' : 'lazy'}
            data-case-visual={stage.id}
            data-active={index === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const DESKTOP_QUERY = '(min-width: 901px)';
  const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';
  const STEP_THRESHOLD = 120;
  const MAX_EVENT_DELTA = 60;
  const GESTURE_IDLE_MS = 120;
  const REST_LINE = 0.38;
  const SPRING_STIFFNESS = 180;
  const SPRING_DAMPING = 26;
  const SPRING_TIME_SCALE = 1.5;
  const MAX_TENSION_PX = 14;

  const story = document.querySelector<HTMLElement>('[data-case-story]');
  const stageElements = Array.from(document.querySelectorAll<HTMLElement>('[data-case-stage]'));
  const triggers = stageElements
    .map((stage) => stage.querySelector<HTMLElement>('[data-case-trigger]'))
    .filter((trigger): trigger is HTMLElement => Boolean(trigger));
  const visualElements = Array.from(document.querySelectorAll<HTMLElement>('[data-case-visual]'));
  const desktopQuery = window.matchMedia(DESKTOP_QUERY);
  const reducedMotionQuery = window.matchMedia(REDUCED_MOTION_QUERY);

  let activeIndex = 0;
  // Discrete wheel state survives interrupted/unfinished scroll positioning.
  let wheelOwnsState = false;
  let accumulatedDelta = 0;
  let gestureActive = false;
  let committedInGesture = false;
  let lastWheelTime = 0;
  let gestureIdleTimer: number | undefined;
  let fallbackFrame = 0;
  let animationFrame = 0;
  let animationMode: 'scroll' | 'tension' | null = null;
  let animationLastTime = 0;
  let springPosition = 0;
  let springVelocity = 0;
  let springTarget = 0;
  let tensionValue = 0;
  let observer: IntersectionObserver | undefined;
  let previousScrollBehavior: string | null = null;
  let lastObservedY = window.scrollY;

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  const setActiveIndex = (nextIndex: number) => {
    const boundedIndex = clamp(nextIndex, 0, stageElements.length - 1);
    if (boundedIndex === activeIndex) return;
    activeIndex = boundedIndex;
    if (story) story.dataset.centered = String(activeIndex > 0);

    stageElements.forEach((stage, index) => {
      stage.classList.toggle('is-active', index === activeIndex);
      stage.classList.remove('is-preview');
      stage.style.removeProperty('--case-preview-progress');
    });

    visualElements.forEach((visual, index) => {
      visual.dataset.active = String(index === activeIndex);
    });
  };

  const clearPreview = () => {
    stageElements.forEach((stage) => {
      stage.classList.remove('is-preview');
      stage.style.removeProperty('--case-preview-progress');
    });
  };

  const renderTension = (value: number) => {
    if (!story) return;

    tensionValue = clamp(value, -1, 1);
    // Slow initial motion, with stronger resistance near the detent.
    const progress = Math.pow(Math.abs(tensionValue), 1.35);
    const direction = Math.sign(tensionValue);

    story.classList.toggle('is-tensioning', progress > 0.001);
    story.style.setProperty('--case-active-translate-y', `${-direction * progress * MAX_TENSION_PX}px`);
    story.style.setProperty('--case-active-scale', String(1 - progress * 0.025));
    story.style.setProperty('--case-active-opacity', String(1 - progress * 0.32));

    clearPreview();
    const previewIndex = activeIndex + direction;
    const preview = stageElements[previewIndex];
    if (preview && progress > 0) {
      preview.classList.add('is-preview');
      preview.style.setProperty('--case-preview-progress', String(progress));
    }
  };

  const clearTension = () => {
    if (!story) return;

    tensionValue = 0;
    springVelocity = 0;
    story.classList.remove('is-tensioning');
    story.style.removeProperty('--case-active-translate-y');
    story.style.removeProperty('--case-active-scale');
    story.style.removeProperty('--case-active-opacity');
    clearPreview();
  };

  const restoreScrollBehavior = () => {
    if (previousScrollBehavior === null) return;
    document.documentElement.style.scrollBehavior = previousScrollBehavior;
    previousScrollBehavior = null;
  };

  const cancelAnimation = () => {
    const wasScrolling = animationMode === 'scroll';
    if (animationFrame) cancelAnimationFrame(animationFrame);
    animationFrame = 0;
    animationMode = null;
    springVelocity = 0;
    if (wasScrolling) restoreScrollBehavior();
  };

  const finishAnimation = () => {
    const completedMode = animationMode;

    if (completedMode === 'scroll') {
      window.scrollTo(0, springTarget);
      lastObservedY = window.scrollY;
      restoreScrollBehavior();
    } else {
      clearTension();
    }

    animationFrame = 0;
    animationMode = null;
    springVelocity = 0;

    if (completedMode === 'tension') scheduleFallback();
  };

  const runSpring = (time: number) => {
    if (!animationMode) return;

    const deltaTime = Math.min(
      0.032,
      Math.max(0.001, ((time - animationLastTime) / 1000) * SPRING_TIME_SCALE),
    );
    animationLastTime = time;
    const distance = springTarget - springPosition;
    const acceleration = distance * SPRING_STIFFNESS - springVelocity * SPRING_DAMPING;

    springVelocity += acceleration * deltaTime;
    const nextPosition = springPosition + springVelocity * deltaTime;
    // Never overshoot or move against the user's committed direction.
    springPosition = clamp(
      nextPosition,
      Math.min(springPosition, springTarget),
      Math.max(springPosition, springTarget),
    );

    if (animationMode === 'scroll') {
      window.scrollTo(0, springPosition);
    } else {
      renderTension(springPosition);
    }

    if (Math.abs(distance) < 0.5 && Math.abs(springVelocity) < 0.5) {
      finishAnimation();
      return;
    }

    animationFrame = requestAnimationFrame(runSpring);
  };

  const startSpring = (mode: 'scroll' | 'tension', position: number, target: number) => {
    cancelAnimation();
    animationMode = mode;

    if (mode === 'scroll') {
      previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
    }

    springPosition = position;
    springTarget = target;
    springVelocity = 0;
    animationLastTime = performance.now();
    animationFrame = requestAnimationFrame(runSpring);
  };

  const restPosition = (index: number) => {
    if (index === 0) return window.innerHeight * REST_LINE;
    const content = stageElements[index]?.querySelector<HTMLElement>('.case-stage__content');
    const triggerOffset = triggers[index]?.offsetTop ?? 0;
    return window.innerHeight / 2 - (content?.offsetHeight ?? 0) / 2 + triggerOffset;
  };

  const springToActiveStage = (direction: number) => {
    const trigger = triggers[activeIndex];
    if (!trigger) return;

    const triggerDocumentY = window.scrollY + trigger.getBoundingClientRect().top;
    const maximumScroll = document.documentElement.scrollHeight - window.innerHeight;
    const requested = clamp(triggerDocumentY - restPosition(activeIndex), 0, maximumScroll);
    const destination = direction > 0
      ? Math.max(window.scrollY, requested)
      : Math.min(window.scrollY, requested);

    startSpring('scroll', window.scrollY, destination);
  };

  const syncFromPosition = () => {
    fallbackFrame = 0;
    if (!story || !desktopQuery.matches || gestureActive || animationMode || wheelOwnsState || accumulatedDelta !== 0) return;

    let nextIndex = 0;

    triggers.forEach((trigger, index) => {
      if (trigger.getBoundingClientRect().top <= restPosition(index) + 2) nextIndex = index;
    });

    setActiveIndex(nextIndex);
  };

  const scheduleFallback = () => {
    if (
      !desktopQuery.matches ||
      gestureActive ||
      animationMode ||
      fallbackFrame
    ) {
      return;
    }

    fallbackFrame = requestAnimationFrame(syncFromPosition);
  };

  const isStoryInWorkingArea = () => {
    if (!story) return false;
    const bounds = story.getBoundingClientRect();
    const restY = window.innerHeight * REST_LINE;
    return bounds.top <= restY && bounds.bottom >= restY;
  };

  const normalizeWheelDelta = (event: WheelEvent) => {
    const multiplier =
      event.deltaMode === WheelEvent.DOM_DELTA_LINE
        ? 16
        : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
          ? window.innerHeight
          : 1;

    return clamp(event.deltaY * multiplier, -MAX_EVENT_DELTA, MAX_EVENT_DELTA);
  };

  const finishGesture = () => {
    gestureActive = false;
    committedInGesture = false;
    gestureIdleTimer = undefined;
    // Keep unfinished progress: separate light wheel ticks continue the pull.
    // Only an explicit reverse movement or native navigation releases it.
  };

  const armGestureEnd = () => {
    if (gestureIdleTimer) window.clearTimeout(gestureIdleTimer);
    gestureIdleTimer = window.setTimeout(finishGesture, GESTURE_IDLE_MS);
  };

  const beginGesture = () => {
    gestureActive = true;
    committedInGesture = false;
    // Keep settling until another step actually reaches its threshold.
    // A light reverse tick must not strand the active block between positions.
  };

  const commitStep = (direction: number) => {
    committedInGesture = true;
    accumulatedDelta = 0;
    clearTension();
    setActiveIndex(activeIndex + direction);
    springToActiveStage(direction);
  };

  const onWheel = (event: WheelEvent) => {
    if (
      !story ||
      !desktopQuery.matches ||
      reducedMotionQuery.matches ||
      event.ctrlKey ||
      Math.abs(event.deltaX) >= Math.abs(event.deltaY)
    ) {
      return;
    }

    const delta = normalizeWheelDelta(event);
    const direction = Math.sign(delta);
    if (!direction) return;

    if (!event.cancelable) return;
    const now = performance.now();
    const continuesGesture = gestureActive && now - lastWheelTime < GESTURE_IDLE_MS;

    // Direction jitter is still the same gesture, including after commitment.
    if (continuesGesture && committedInGesture) {
      event.preventDefault();
      lastWheelTime = now;
      armGestureEnd();
      return;
    }

    if (!animationMode && accumulatedDelta === 0 && !gestureActive) syncFromPosition();

    const isOutwardBoundary =
      (activeIndex === 0 && direction < 0) ||
      (activeIndex === stageElements.length - 1 && direction > 0);

    // Finish the last committed step before releasing native page scrolling.
    if (animationMode === 'scroll' && isOutwardBoundary) {
      event.preventDefault();
      return;
    }

    if (!isStoryInWorkingArea() || (isOutwardBoundary && accumulatedDelta === 0)) {
      resetInteraction();
      return;
    }

    event.preventDefault();
    wheelOwnsState = true;
    if (!continuesGesture) beginGesture();
    lastWheelTime = now;
    armGestureEnd();

    // Reverse impulses first unwind existing tension, rather than initiating
    // an opposite step while the finger is still finishing its previous swipe.
    const previousDirection = Math.sign(accumulatedDelta);
    const nextDelta = accumulatedDelta + delta;
    accumulatedDelta = previousDirection && Math.sign(nextDelta) !== previousDirection
      ? 0
      : nextDelta;

    renderTension(accumulatedDelta / STEP_THRESHOLD);

    if (Math.abs(accumulatedDelta) >= STEP_THRESHOLD) {
      commitStep(Math.sign(accumulatedDelta));
    }
  };

  const resetInteraction = () => {
    if (gestureIdleTimer) window.clearTimeout(gestureIdleTimer);
    gestureIdleTimer = undefined;
    gestureActive = false;
    committedInGesture = false;
    wheelOwnsState = false;
    accumulatedDelta = 0;
    cancelAnimation();
    clearTension();
    lastObservedY = window.scrollY;
  };

  const onNativeScroll = () => {
    const moved = Math.abs(window.scrollY - lastObservedY) > 0.5;
    lastObservedY = window.scrollY;
    if (animationMode) return;
    if (moved) {
      resetInteraction();
      scheduleFallback();
    }
  };

  const onNativeNavigation = () => {
    resetInteraction();
    scheduleFallback();
  };

  const setupFallback = () => {
    observer?.disconnect();
    resetInteraction();

    if (!story || !desktopQuery.matches) {
      cancelAnimation();
      clearTension();
      return;
    }

    const visual = story.querySelector<HTMLElement>('.case-story__visual');
    const visualHeight = visual?.offsetHeight ?? 577;
    story.style.setProperty('--case-centered-offset', `${Math.max(16, (window.innerHeight - visualHeight) / 2)}px`);
    const lastContent = stageElements.at(-1)?.querySelector<HTMLElement>('.case-stage__content');
    story.style.setProperty('--case-last-visual-space', `${(visualHeight + (lastContent?.offsetHeight ?? 0)) / 2}px`);
    story.dataset.centered = String(activeIndex > 0);

    const about = stageElements[0]?.querySelector<HTMLElement>('.case-stage__content');
    story.style.setProperty(
      '--case-problem-extra-gap',
      `${(about?.offsetHeight ?? 0) * (1 - 0.6667)}px`,
    );

    const restY = window.innerHeight * REST_LINE;
    observer = new IntersectionObserver(scheduleFallback, {
      rootMargin: `-${restY}px 0px -${Math.max(0, window.innerHeight - restY - 1)}px 0px`,
      threshold: 0,
    });

    triggers.forEach((trigger) => observer?.observe(trigger));
    syncFromPosition();
  };

  window.addEventListener('wheel', onWheel, { passive: false });
  window.addEventListener('scroll', onNativeScroll, { passive: true });
  window.addEventListener('pointerdown', onNativeNavigation, { passive: true });
  window.addEventListener('touchstart', onNativeNavigation, { passive: true });
  window.addEventListener('keydown', (event) => {
    if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) {
      onNativeNavigation();
    }
  });
  window.addEventListener('resize', setupFallback);
  desktopQuery.addEventListener('change', setupFallback);
  reducedMotionQuery.addEventListener('change', setupFallback);
  document.fonts.ready.then(setupFallback);
  setupFallback();
</script>

<style>
  .case-page {
    --case-sticky-offset: 72px;
    --case-stage-spacing: 150px;
    --case-inactive-opacity: 0.28;
    --case-transition-duration: 420ms;
    --case-image-fade-duration: 340ms;
    --case-image-motion-duration: 440ms;
    --case-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    padding-block: 43px 120px;
  }

  .case-shell {
    width: min(calc(100% - (var(--page-padding) * 2)), 1322px);
    margin-inline: auto;
  }

  .case-hero__media {
    aspect-ratio: 1322 / 636;
    overflow: hidden;
    border: 1px solid #f2f2f2;
    border-radius: 30px;
    box-shadow: 14px 9px 35px rgb(24 94 185 / 6%);
  }

  .case-hero__media :global(img) {
    width: 100%;
    height: 116.92%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .case-hero__copy {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .case-hero h1,
  .case-hero p,
  .case-stage h2,
  .case-stage p,
  .case-stage dl,
  .case-stage dd {
    margin: 0;
  }

  .case-hero h1 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.2;
  }

  .case-hero p {
    max-width: 900px;
    font-family: var(--font-ui);
    line-height: 1.25;
  }

  .case-story {
    display: grid;
    grid-template-columns: minmax(340px, 503px) minmax(420px, 577px);
    justify-content: space-between;
    align-items: start;
    column-gap: clamp(64px, 12.6vw, 242px);
    margin-top: 73px;
  }

  .case-story__copy {
    display: grid;
    row-gap: var(--case-stage-spacing);
  }

  .case-stage {
    position: relative;
    display: flex;
    align-items: flex-start;
    font-family: var(--font-ui);
  }

  @media (min-width: 901px) {
    .case-stage[data-case-stage='problem'] {
      margin-bottom: var(--case-problem-extra-gap, 100px);
    }
  }

  .case-stage:last-child {
    min-height: max(50vh, calc(62vh - 80px), var(--case-last-visual-space, 0px));
  }

  .case-stage__content {
    width: 100%;
    opacity: var(--case-inactive-opacity);
    transform: scale(0.6667);
    transform-origin: left top;
    transition:
      opacity var(--case-transition-duration) var(--case-ease-out),
      transform var(--case-transition-duration) var(--case-ease-out);
  }


  .case-stage__observer-target {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 30px;
    pointer-events: none;
  }

  .case-stage__observer-target.is-delayed {
    top: 30px;
  }

  .case-stage.is-active .case-stage__content {
    opacity: var(--case-active-opacity, 1);
    transform:
      translateY(var(--case-active-translate-y, 0px))
      scale(var(--case-active-scale, 1));
  }

  .case-story.is-tensioning .case-stage.is-active .case-stage__content,
  .case-story.is-tensioning .case-stage.is-preview .case-stage__content {
    transition: none;
    will-change: opacity, transform;
  }

  .case-stage.is-preview .case-stage__content {
    opacity: calc(
      var(--case-inactive-opacity) + var(--case-preview-progress, 0) * 0.18
    );
    transform:
      translateY(calc(var(--case-active-translate-y, 0px) * 0.6))
      scale(calc(0.6667 + var(--case-preview-progress, 0) * 0.1));
  }

  .case-stage h2 {
    margin-bottom: 24px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
  }

  .case-stage__body {
    display: grid;
    gap: 16px;
    font-size: 16px;
    line-height: 1.25;
  }

  .case-stage dl {
    display: grid;
    margin-top: 8px;
  }

  .case-stage dl div {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .case-stage dt {
    flex: 0 0 auto;
    font-weight: 600;
    white-space: nowrap;
  }
  .case-stage dt::after {
    content: ':';
  }


  .case-stage__mobile-visual {
    display: none;
  }

  .case-story__visual {
    position: sticky;
    top: var(--case-sticky-offset);
    width: min(100%, 577px);
    aspect-ratio: 1;
    justify-self: end;
    overflow: hidden;
    border: 2px solid #ebeff9;
    border-radius: 30px;
