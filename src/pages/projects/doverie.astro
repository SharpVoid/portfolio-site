---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import doverieHero from '../../assets/projects/doverie-hero.png';
import Footer from '../../components/Footer.astro';
import doverieFlow from '../../assets/projects/doverie-flow.png';
import doverieArchitecture from '../../assets/projects/doverie-architecture.png';

interface Stage {
  id: string;
  title: string;
  image?: ImageMetadata;
  video?: string;
  poster?: string;
  alt: string;
  paragraphs: string[];
  meta?: { term: string; value: string }[];
}

const stages: Stage[] = [
  {
    id: 'about', title: 'О проекте',
    video: '/videos/doverie/about.mp4',
    poster: '/videos/doverie/about-poster.png',
    alt: 'Главный экран банка «Доверие» над раскрытыми ладонями',
    paragraphs: ['Проект был разработан в рамках магистерской диссертации. Я самостоятельно сформулировал продуктовую гипотезу, разработал архитектуру социального слоя с учётом технических и юридических ограничений, спроектировал пользовательские сценарии и интерфейсы, собрал интерактивный прототип и обсудил концепцию с пользователями банковских приложений.'],
    meta: [
      { term: 'Моя роль', value: 'продуктовый дизайнер и исследователь' },
      { term: 'Формат', value: 'самостоятельный магистерский проект' },
      { term: 'Зона ответственности', value: 'продуктовая концепция, архитектура, сценарии, UI и прототипирование' },
    ],
  },
  {
    id: 'problem', title: 'Проблема', image: doverieFlow,
    alt: 'Разрозненный процесс: обсуждение в мессенджере, перевод через банк, ручная сверка оплаты и потеря контекста',
    paragraphs: [
    "При совместных расходах людям приходится постоянно переключаться между банковским приложением и мессенджерами.",
    "В одном месте они договариваются о суммах и участниках, в другом переводят деньги, а затем вручную проверяют, кто уже заплатил.",
    "Сам перевод выполняется быстро, но весь процесс вокруг него остаётся разрозненным. Добавление удобства должно логично встраиваться в уже существующий банковский интерфейс не перегружая его базовые функции преврещая приложение в super-app."
],
  },
  {
    id: 'solution', title: 'Моё решение', image: doverieArchitecture,
    alt: 'Модульная архитектура: социальный слой связывает базовый банк, общий счёт, переводы рядом, профиль, уведомления и друзей',
    paragraphs: [
    "Основой концепции стал модуль «Друзья». \nМодуль «Друзья» это закрытый круг доверенных контактов внутри банковского приложения. Он связывает профиль пользователя, совместные счета, переводы поблизости, уведомления и настройки приватности.",
    "Я разделил систему на независимые модули, чтобы социальный слой можно было развивать постепенно и не смешивать его с базовыми банковскими операциями."
],
  },
  {
    id: 'shared-account', title: '«Общий счёт»',
    video: '/videos/doverie/shared-account.mp4',
    poster: '/videos/doverie/shared-account-poster.png',
    alt: 'Видеопрототип создания общего события и разделения расходов',
    paragraphs: [
    "Пользователь создаёт совместное событие, приглашает участников и добавляет расход. Сумму можно внести вручную или получить из отсканированного чека. \nВсе участники видят общий процесс в котором указан статус у каждого участника и сколько всего осталось внести.",
    "Это заменяет несколько отдельных переводов и необходимость вручную напоминать каждому участнику об оплате."
],
  },
  {
    id: 'nearby', title: '«Рядом»',
    video: '/videos/doverie/nearby.mp4',
    poster: '/videos/doverie/nearby-poster.png',
    alt: 'Видеопрототип перевода человеку поблизости',
    paragraphs: [
    "Сценарий «Рядом» позволяет выбрать человека, находящегося поблизости, и отправить ему перевод без поиска номера телефона или банковских реквизитов. Интерфейс не показывает точное расстояние или координаты. Вместо этого пользователь видит только категориальную близость, что снижает риск нежелательного раскрытия местоположения.",
    "Для определения близости я рассматривал Bluetooth Low Energy и оценку сигнала через RSSI. У технологии есть ограничения: показания зависят от устройства, препятствий и окружающей среды. Поэтому решение требует проверки на реальных смартфонах и не должно использоваться для определения точного расстояния."
],
  },
];
const tags = ['FinTech', 'Mobile Banking', 'Product Design', 'UX Research', 'Interaction Design', 'Prototyping'];
---

<BaseLayout
  title="«Доверие» — социальные сценарии в банковском приложении"
  description="Кейс продуктового дизайна банковского приложения с социальными сценариями"
>
  <main class="case-page">
    <nav class="case-nav case-shell" aria-label="Навигация по портфолио">
      <a href="/">← Главная</a>
      <a href="https://t.me/sharpvoid">Связаться</a>
    </nav>
    <header class="case-hero case-shell">
      <div class="case-hero__media">
        <Image
          src={doverieHero}
          alt="Главный экран банка «Доверие» на фоне мягкого голубого градиента"
          widths={[640, 960, 1322, 2080]}
          sizes="(max-width: 1024px) calc(100vw - 60px), (max-width: 1440px) calc(100vw - 200px), 1326px"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="case-hero__copy">
        <h1>«Доверие»: социальные сценарии в банковском приложении</h1>
        <p>Идея создания социального слоя для банковского приложения, в которой объединяются финансовые операции и взаимодействие между знакомыми людьми.</p>
      </div>
      <div class="case-tags" data-tags>
        {tags.map((tag, index) => <span class:list={['case-tag', { 'case-tag--extra': index > 1 }]} style={`--tag-delay: ${Math.max(0, index - 2) * 50}ms`}>{tag}</span>)}
        <button class="case-tag case-tags__toggle" type="button" aria-expanded="false" aria-label="Показать ещё четыре направления">+4</button>
      </div>
    </header>

    <section class="case-story case-shell" data-case-story aria-label="Кратко о проекте">
      <div class="case-story__copy">
        {stages.map((stage, index) => (
          <article
            class:list={['case-stage', { 'is-active': index === 0 }]}
            data-case-stage={stage.id}
          >
            <span
              class:list={['case-stage__observer-target', { 'is-delayed': index > 0 }]}
              data-case-trigger
              aria-hidden="true"
            ></span>

            <div class="case-stage__content">
              <h2>{stage.title}</h2>

              <div class="case-stage__body">
                {stage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

                {stage.meta && (
                  <dl>
                    {stage.meta.map((item) => (
                      <div>
                        <dt>{item.term}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            </div>

            <div class="case-stage__mobile-visual" data-stage-image={stage.id} data-active={index === 0 ? 'true' : 'false'}>
              {stage.image ? (
                <Image src={stage.image} alt={stage.alt} quality={90} loading="lazy" />
              ) : (
                <video src={stage.video} poster={stage.poster} data-case-video
                  muted loop playsinline controls preload="none" aria-label={stage.alt}></video>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="case-story__visual">
        {stages.map((stage, index) => (
          <div class="case-story__image" data-case-visual={stage.id}
            data-active={index === 0 ? 'true' : 'false'} inert={index !== 0}
            aria-hidden={index !== 0 ? 'true' : undefined}>
            {stage.image ? (
              <Image src={stage.image} alt={stage.alt} quality={90} loading="eager" />
            ) : (
              <video src={stage.video} poster={stage.poster} data-case-video
                muted loop playsinline controls preload="none" aria-label={stage.alt}></video>
            )}
          </div>
        ))}
      </div>
    </section>
    <section class="case-contact case-shell" id="contacts" aria-labelledby="contact-title">
      <div class="case-contact__pitch">
        <h2 id="contact-title">Есть задача или подходящая роль?</h2>
        <p>Буду рад обсудить продукт, команду или сотрудничество</p>
        <a class="case-contact__button" href="https://t.me/sharpvoid">Связаться</a>
      </div>
      <nav class="case-project-nav" aria-label="Другие проекты">
        <a href="/#projects">← Все проекты</a>
        <a href="/#projects">Следующий кейс →</a>
      </nav>
      <div class="case-footer">
        <Footer />
        <div class="case-footer__links">
          <span aria-disabled="true" title="Резюме пока не опубликовано">Резюме</span>
          <a href="mailto:lisenkomike.v@gmail.com">lisenkomike.v@gmail.com</a>
          <a href="https://t.me/sharpvoid">@sharpvoid</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { createSteppedScroll } from '../../lib/steppedScroll';
  const REST_LINE = 0.38;
  const MAX_TENSION_PX = 14;
  const story = document.querySelector<HTMLElement>('[data-case-story]');
  const stageElements = Array.from(document.querySelectorAll<HTMLElement>('[data-case-stage]'));
  const triggers = stageElements
    .map((stage) => stage.querySelector<HTMLElement>('[data-case-trigger]'))
    .filter((trigger): trigger is HTMLElement => Boolean(trigger));
  const visualElements = Array.from(document.querySelectorAll<HTMLElement>('[data-case-visual]'));


  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-case-video]')];
  const visibleVideos = new Set<HTMLVideoElement>();
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 900px)');
  function syncVideos() {
    videos.forEach((video) => {
      const active = video.closest<HTMLElement>('[data-case-visual], [data-stage-image]')?.dataset.active !== 'false';
      if (visibleVideos.has(video) && active && !reducedMotion.matches && !document.hidden) {
        void video.play().catch(() => { /* Native controls remain available if autoplay is blocked. */ });
      } else {
        video.pause();
      }
    });
  }
  const videoObserver = new IntersectionObserver((entries) => {
    entries.forEach(({ target, isIntersecting }) => {
      const video = target as HTMLVideoElement;
      if (isIntersecting) visibleVideos.add(video);
      else visibleVideos.delete(video);
    });
    syncVideos();
  }, { threshold: 0 });
  videos.forEach(video => videoObserver.observe(video));
  reducedMotion.addEventListener('change', syncVideos);
  document.addEventListener('visibilitychange', syncVideos);
  document.addEventListener('astro:before-swap', () => {
    videoObserver.disconnect();
    videos.forEach(video => video.pause());
    reducedMotion.removeEventListener('change', syncVideos);
    document.removeEventListener('visibilitychange', syncVideos);
  }, { once: true });

  const tags = document.querySelector<HTMLElement>('[data-tags]');
  const toggle = tags?.querySelector<HTMLButtonElement>('button');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.setAttribute('aria-label', expanded ? 'Скрыть дополнительные направления' : 'Показать ещё четыре направления');
    toggle.textContent = expanded ? 'скрыть' : '+4';
    tags?.classList.toggle('is-expanded', expanded);
  });

  if (story && triggers.length === stageElements.length && triggers.length > 0) {
    let activeIndex = 0;
    let tensionValue = 0;
    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));
    const updateStageSpacing = () => {
      const heights = stageElements.map(stage =>
        stage.querySelector<HTMLElement>('.case-stage__content')?.offsetHeight ?? 0);
      const extra = heights[0] * (1 - 0.6667);
      stageElements.forEach((stage, index) => {
        // Match Problem's visible gaps, including space hidden by the preceding scale.
        const gap = activeIndex === 0 ? (index === 1 ? extra : 0)
          : index === activeIndex ? extra
          : index === activeIndex - 1 ? extra - heights[index] * (1 - 0.6667) : 0;
        stage.style.setProperty('--case-stage-extra-gap', `${gap}px`);
      });
    };
    const setActiveIndex = (nextIndex: number) => {
      const boundedIndex = clamp(nextIndex, 0, stageElements.length - 1);
      if (boundedIndex === activeIndex) return;
      activeIndex = boundedIndex;
      updateStageSpacing();
      if (story) story.dataset.centered = String(activeIndex > 0);

      stageElements.forEach((stage, index) => {
        stage.classList.toggle('is-active', index === activeIndex);
        const media = stage.querySelector<HTMLElement>('[data-stage-image]');
        if (media) media.dataset.active = String(index === activeIndex);
        stage.classList.remove('is-preview');
        stage.style.removeProperty('--case-preview-progress');
      });

      visualElements.forEach((visual, index) => {
        visual.dataset.active = String(index === activeIndex);
        visual.inert = index !== activeIndex;
        visual.setAttribute('aria-hidden', String(index !== activeIndex));
      });
      syncVideos();
    };

    const clearPreview = () => {
      stageElements.forEach((stage) => {
        stage.classList.remove('is-preview');
        stage.style.removeProperty('--case-preview-progress');
      });
    };

    const renderTension = (value: number) => {
      if (!story) return;

      tensionValue = clamp(value, -1, 1);
      // Slow initial motion, with stronger resistance near the detent.
      const progress = Math.pow(Math.abs(tensionValue), 1.35);
      const direction = Math.sign(tensionValue);

      story.classList.toggle('is-tensioning', progress > 0.001);
      story.style.setProperty('--case-active-translate-y', `${-direction * progress * MAX_TENSION_PX}px`);
      story.style.setProperty('--case-active-scale', String(1 - progress * 0.025));
      story.style.setProperty('--case-active-opacity', String(1 - progress * 0.32));

      clearPreview();
      const previewIndex = activeIndex + direction;
      const preview = stageElements[previewIndex];
      if (preview && progress > 0) {
        preview.classList.add('is-preview');
        preview.style.setProperty('--case-preview-progress', String(progress));
      }
    };

    const clearTension = () => {
      if (!story) return;

      tensionValue = 0;
      story.classList.remove('is-tensioning');
      story.style.removeProperty('--case-active-translate-y');
      story.style.removeProperty('--case-active-scale');
      story.style.removeProperty('--case-active-opacity');
      clearPreview();
    };

    const restPosition = (index: number) => {
      if (mobile.matches) {
        // Tall video steps start at the top; smaller text/media pairs center together.
        const top = index >= 3 ? 24 : Math.max(24, (window.innerHeight - stageElements[index].offsetHeight) / 2);
        return top + triggers[index].offsetTop;
      }
      if (index === 0) return window.innerHeight * REST_LINE;
      const content = stageElements[index]?.querySelector<HTMLElement>('.case-stage__content');
      const triggerOffset = triggers[index]?.offsetTop ?? 0;
      return window.innerHeight / 2 - (content?.offsetHeight ?? 0) / 2 + triggerOffset;
    };


    const controller = createSteppedScroll({
      container: story,
      triggers,
      restLine: REST_LINE,
      restPosition,
      touch: {
        threshold: 80,
        axisThreshold: 8,
        scrollRange: (index) => {
          const stage = stageElements[index].getBoundingClientRect();
          const start = window.scrollY + stage.top + triggers[index].offsetTop - restPosition(index);
          return { start, end: Math.max(start, window.scrollY + stage.bottom - window.innerHeight + 24) };
        },
      },
      onStep: setActiveIndex,
      onTension: renderTension,
      onClearTension: clearTension,
      onMeasure: () => {
        const visual = story.querySelector<HTMLElement>('.case-story__visual');
        const visualHeight = visual?.offsetHeight ?? 577;
        const lastContent = stageElements.at(-1)?.querySelector<HTMLElement>('.case-stage__content');
        story.style.setProperty('--case-last-visual-space', `${(visualHeight + (lastContent?.offsetHeight ?? 0)) / 2}px`);
        story.dataset.centered = String(activeIndex > 0);

        updateStageSpacing();

      },
    });
    // Tear down before an Astro client-side navigation; harmless without a router.
    document.addEventListener('astro:before-swap', () => controller.destroy(), { once: true });
  }
</script>

<style>
  .case-page {
    --case-sticky-offset: 72px;
    --case-stage-spacing: 150px;
    --case-inactive-opacity: 0.28;
    --case-transition-duration: 420ms;
    --case-image-fade-duration: 340ms;
    --case-image-motion-duration: 440ms;
    --case-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --page-padding: clamp(30px, calc(16.827vw - 142.31px), 100px);
    padding-block: 34px 34px;
  }
  .case-shell { width: min(calc(100% - var(--page-padding) * 2), 1326px); margin-inline: auto; }
  .case-nav, .case-project-nav { display: flex; justify-content: space-between; gap: 24px; color: var(--color-accent); }
  .case-nav a, .case-project-nav a { text-decoration: none; }
  .case-nav { margin-bottom: 54px; }
  .case-hero__media {
    height: 636px; overflow: hidden; border: 1px solid #f2f2f2;
    border-radius: 30px; box-shadow: 14px 9px 35px rgb(24 94 185 / 6%);
  }
  .case-hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .case-hero__copy { display: grid; gap: 16px; margin-top: 32px; }
  .case-hero h1, .case-hero p, .case-stage h2, .case-stage p,
  .case-stage dl, .case-stage dd, .case-contact h2, .case-contact p { margin: 0; }
  .case-hero h1 { font-size: 38px; font-weight: 700; line-height: 1.26; }
  .case-hero p { font-size: 20px; line-height: 1.3; }
  .case-tags { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 28px; }
  .case-tag { padding: 5px 10px; border: 0; border-radius: 15px; background: #ebf9ff; color: #004d6e; font: 600 14px/18px var(--font-sans); }
  .case-tags__toggle { display: none; cursor: pointer; }
  .case-tags__toggle:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .case-story {
    --case-visual-height: min(673px, calc(100svh - 32px));
    --case-centered-offset: max(16px, calc((100vh - var(--case-visual-height)) / 2));
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start; column-gap: 82px; margin-top: 74px;
  }
  .case-story__copy { display: grid; row-gap: var(--case-stage-spacing); min-width: 0; }
  .case-stage { position: relative; display: flex; align-items: flex-start; }
  @media (min-width: 901px) {
    .case-stage { margin-bottom: var(--case-stage-extra-gap, 0px); }
  }
  .case-stage:last-child { min-height: max(50vh, calc(62vh - 80px), var(--case-last-visual-space, 0px)); }
  .case-stage__content {
    width: 100%;
    opacity: var(--case-inactive-opacity);
    transform: scale(0.6667);
    transform-origin: left top;
    transition:
      opacity var(--case-transition-duration) var(--case-ease-out),
      transform var(--case-transition-duration) var(--case-ease-out);
  }


  .case-stage__observer-target {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 30px;
    pointer-events: none;
  }

  .case-stage__observer-target.is-delayed {
    top: 30px;
  }

  .case-stage.is-active .case-stage__content {
    opacity: var(--case-active-opacity, 1);
    transform:
      translateY(var(--case-active-translate-y, 0px))
      scale(var(--case-active-scale, 1));
  }

  .case-story.is-tensioning .case-stage.is-active .case-stage__content,
  .case-story.is-tensioning .case-stage.is-preview .case-stage__content {
    transition: none;
    will-change: opacity, transform;
  }

  .case-stage.is-preview .case-stage__content {
    opacity: calc(
      var(--case-inactive-opacity) + var(--case-preview-progress, 0) * 0.18
    );
    transform:
      translateY(calc(var(--case-active-translate-y, 0px) * 0.6))
      scale(calc(0.6667 + var(--case-preview-progress, 0) * 0.1));
  }


  .case-stage h2 { margin-bottom: 18px; font-size: 24px; font-weight: 700; line-height: 1.3; }
  .case-stage__body { display: grid; gap: 20px; font-size: 16px; line-height: 1.25; }
  .case-stage__body p { white-space: pre-line; }
  .case-stage dl div { display: inline; }
  .case-stage dl div::after { content: ''; display: block; }
  .case-stage dt { display: inline; font-weight: 700; white-space: nowrap; }
  .case-stage dt::after { content: ': '; }
  .case-stage dd { display: inline; }
  .case-stage__mobile-visual { display: none; }
  .case-story__visual {
    position: sticky; top: var(--case-sticky-offset);
    width: 100%; height: var(--case-visual-height);
    justify-self: end;
    transition: top var(--case-image-motion-duration) var(--case-ease-out);
  }
  @media (min-width: 901px) {
    .case-story[data-centered='true'] .case-story__visual { top: var(--case-centered-offset); }
  }
  .case-story__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(13px) scale(0.985);
    transition:
      opacity var(--case-image-fade-duration) var(--case-ease-out),
      transform var(--case-image-motion-duration) var(--case-ease-out);
    will-change: opacity, transform;
  }

  .case-story__image[data-active='true'] {
    z-index: 1;
    pointer-events: auto;
    opacity: 1;
