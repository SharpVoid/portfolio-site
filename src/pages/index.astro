---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout
	title="Портфолио"
	description="Работы и проекты Михаила Лисенко"
>
	<Header />

	<main>
		<section class="page-intro" aria-labelledby="page-title">
			<h1 id="page-title">Портфолио</h1>
			<p>Технический каркас для будущих проектов.</p>
		</section>

		<section id="projects" aria-label="Проекты">
			<ProjectCard
				title="Тестовый проект"
				description="Временная карточка для проверки структуры портфолио."
				image=""
				href="#projects"
				year="2026"
			/>
		</section>
	</main>

	<Footer />
</BaseLayout>
