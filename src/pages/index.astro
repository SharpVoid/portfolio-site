---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Profile from '../components/Profile.astro';
import ProjectCard from '../components/ProjectCard.astro';
import focusRectangle from '../assets/projects/focusml-cover-rectanlge.png';
import focusSquare from '../assets/projects/focusml-cover-square.png';
import bankDesktop from '../assets/projects/bank-desktop.png';
import bankMobile from '../assets/projects/bank-mobile.png';
import arenaDesktop from '../assets/projects/arena-desktop.png';
import arenaMobile from '../assets/projects/arena-mobile.png';
import atomDesktop from '../assets/projects/atom-desktop.png';
import atomMobile from '../assets/projects/atom-mobile.png';

const projects = [
  {
    id: 'focusml', video: '/videos/focusml.mp4', title: 'FocusML',
    description: 'Веб-инструмент разметки и обучения моделей машинного зрения',
    image: focusRectangle, mobileImage: focusSquare,
    alt: 'Интерфейс FocusML: разметка изображения арбузов с помощью текстового запроса',
    href: '/projects/focusml/',
    priority: true,
    variants: [
      { image: focusSquare, media: '(min-width: 601px) and (max-width: 900px)' },
      { image: focusSquare, media: '(min-width: 1025px) and (max-width: 1679px)' },
    ],
  },
  {
    id: 'doverie', video: '/videos/doverie.mp4', title: 'Банк «Доверие»',
    description: 'Мобильное банковское приложение с внедрением социальных функций',
    image: bankDesktop, mobileImage: bankMobile,
    alt: 'Главный экран банка «Доверие» на телефоне: баланс, карты и история операций',
    href: '/projects/doverie/',
  },
  {
    id: 'design-arena', video: '/videos/design-arena.mp4', title: 'Дизайн-арена',
    description: 'Мобильное приложение для отслеживания калорий за день. Конкурсная работа внутри дизайн-сообщества',
    image: arenaDesktop, mobileImage: arenaMobile, secondary: true, href: '/projects/design-arena/',
    alt: 'Экран приложения на телефоне с кольцом дневной нормы калорий и показателями питания',
  },
  {
    id: 'atomreport', video: '/videos/atomreport.mp4', title: 'ConsulAI',
    description: 'Веб-сервис подготовки и согласования цифровой отчётности',
    image: atomDesktop, mobileImage: atomMobile, secondary: true, href: 'https://www.consulai.ru/',
    confirmNavigation: true,
    alt: 'Светящиеся цифровые документы и курсор на обложке ConsulAI',
  },
];
---
<BaseLayout title="Портфолио — Лисенко Михаил" description="Работы и проекты Михаила Лисенко — Product designer">
  <main class="portfolio page-container">
    <Profile />
    <section id="projects" class="projects" aria-label="Проекты">
      {projects.map((project) => <ProjectCard {...project} />)}
    </section>
    <Footer />
  </main>
  <dialog id="external-case-dialog" class="external-case-dialog" aria-labelledby="external-case-message">
    <p id="external-case-message">Для просмотра кейса вы переходите на отдельный сайт</p>
    <form method="dialog" class="external-case-dialog__actions">
      <button class="external-case-dialog__confirm" value="confirm" autofocus>Окей</button>
      <button value="cancel">Отмена</button>
    </form>
  </dialog>
</BaseLayout>
<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-confirm-navigation]')!;
  const dialog = document.querySelector<HTMLDialogElement>('#external-case-dialog')!;
  link.addEventListener('click', event => {
    event.preventDefault();
    dialog.returnValue = '';
    dialog.showModal();
  });
  dialog.addEventListener('close', () => {
    if (dialog.returnValue === 'confirm') window.location.assign(link.href);
  });
  dialog.addEventListener('click', event => {
    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
  });
</script>
<style>
  :global(html:has(.external-case-dialog[open])) { overflow: hidden; scrollbar-gutter: stable; }
  .external-case-dialog {
    margin: auto; padding: 32px; width: 440px;
    max-width: calc(100vw - 32px); max-height: calc(100dvh - 32px);
    border: 2px solid #eaeff9; border-radius: 30px;
    background: var(--color-background); color: var(--color-text);
    box-shadow: 14px 9px 35px rgb(24 94 185 / 6%); overscroll-behavior: contain;
  }
  @supports (corner-shape: squircle) { .external-case-dialog { corner-shape: squircle; } }
  .external-case-dialog::backdrop { background: rgb(0 0 0 / 50%); }
  .external-case-dialog p { margin: 0; font-size: 20px; font-weight: 500; line-height: 26px; text-wrap: balance; }
  .external-case-dialog__actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); margin-top: var(--space-lg); }
  .external-case-dialog button {
    min-height: 44px; padding: 10px 20px; border: 0; border-radius: 10px;
    background: var(--color-surface-muted); color: var(--color-text-muted);
    font: 500 16px/20px var(--font-sans); cursor: pointer;
  }
  .external-case-dialog .external-case-dialog__confirm { background: var(--color-accent); color: white; }
  .external-case-dialog button:hover { filter: brightness(0.95); }
  .external-case-dialog button:active { filter: brightness(0.9); }
  .external-case-dialog button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (max-width: 600px) { .external-case-dialog { padding: 24px; border-radius: 20px; } }
  .portfolio { --color-accent: #0053b2; --color-button: #0075e2; display: grid; grid-template-columns: 419px minmax(0, 1fr); column-gap: 80px; padding-block: 50px; }
  .portfolio :global(.site-footer) { color: var(--color-text-muted); }
  .portfolio :global(.site-footer [data-resume-download]) { display: none; }
  @media (min-width: 601px) {
    .portfolio :global(.site-footer__links) { display: block; margin-top: 27px; }
    .portfolio :global(.site-footer .contact-links) { justify-content: start; gap: 12px 43px; }
  }
  @media (min-width: 601px) and (max-width: 1024px) {
    .portfolio :global(.site-footer) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px 32px; }
    .portfolio :global(.site-footer__links) { flex: none; max-width: none; margin-top: 0; }
  }
  @media (min-width: 1025px) {
    .portfolio :global(.site-footer) { top: calc(100dvh - 50px - 66px); }
  }
  .portfolio > :global(.profile) { grid-column: 1; grid-row: 1; }
  @media (min-width: 1025px) and (max-height: 992px) {
    /* Leave 30px between the scrollable profile and the viewport-pinned footer. */
    .portfolio > :global(.profile) { max-height: calc(100dvh - 196px); overflow-y: auto; }
  }
  .projects { display: grid; gap: 48px; min-width: 0; scroll-margin-top: 50px; grid-column: 2; grid-row: 1; }
  @media (max-width: 1024px) {
    .portfolio { grid-template-columns: minmax(0, 1fr); }
    .projects { grid-column: 1; grid-row: auto; margin-top: 80px; }
  }

</style>
