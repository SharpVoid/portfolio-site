---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Profile from '../components/Profile.astro';
import ProjectCard from '../components/ProjectCard.astro';
import focusRectangle from '../assets/projects/focusml-cover-rectanlge.png';
import focusSquare from '../assets/projects/focusml-cover-square.png';
import bankDesktop from '../assets/projects/bank-desktop.png';
import bankMobile from '../assets/projects/bank-mobile.png';
import arenaDesktop from '../assets/projects/arena-desktop.png';
import arenaMobile from '../assets/projects/arena-mobile.png';
import atomDesktop from '../assets/projects/atom-desktop.png';
import atomMobile from '../assets/projects/atom-mobile.png';

// Add published URLs here when available; the existing project has no case routes.
const projects = [
  {
    id: 'focusml', video: '/videos/focusml.mp4', title: 'FocusML',
    description: 'Веб-инструмент разметки и обучения моделей машинного зрения',
    image: focusRectangle, mobileImage: focusSquare,
    alt: 'Интерфейс FocusML: разметка изображения арбузов с помощью текстового запроса',
    priority: true,
    variants: [
      { image: focusSquare, media: '(min-width: 601px) and (max-width: 900px)' },
      { image: focusSquare, media: '(min-width: 1025px) and (max-width: 1679px)' },
    ],
  },
  {
    id: 'doverie', video: '/videos/doverie.mp4', title: 'Банк «Доверие»',
    description: 'Мобильное банковское приложение с внедрением социальных функций',
    image: bankDesktop, mobileImage: bankMobile,
    alt: 'Главный экран банка «Доверие» на телефоне: баланс, карты и история операций',
  },
  {
    id: 'design-arena', video: '/videos/design-arena.mp4', title: 'Дизайн-арена',
    description: 'Мобильное приложение для отслеживания калорий за день. Конкурсная работа',
    image: arenaDesktop, mobileImage: arenaMobile, secondary: true,
    alt: 'Экран приложения на телефоне с кольцом дневной нормы калорий и показателями питания',
  },
  {
    id: 'atomreport', video: '/videos/atomreport.mp4', title: 'АтомРепорт',
    description: 'Веб-сервис подготовки и согласования цифровой отчётности',
    image: atomDesktop, mobileImage: atomMobile, secondary: true,
    alt: 'Светящиеся цифровые документы и курсор на обложке АтомРепорта',
  },
];
---
<BaseLayout title="Портфолио — Лисенко Михаил" description="Работы и проекты Михаила Лисенко — Product designer">
  <main class="portfolio page-container">
    <Profile />
    <section id="projects" class="projects" aria-label="Проекты">
      {projects.map((project) => <ProjectCard {...project} />)}
    </section>
    <Footer />
  </main>
</BaseLayout>
<style>
  .portfolio { display: grid; grid-template-columns: 419px minmax(0, 1fr); column-gap: 80px; padding-block: 50px; }
  .portfolio > :global(.profile) { grid-column: 1; grid-row: 1; }
  @media (min-width: 1025px) and (max-height: 941px) {
    /* Leave 30px between the scrollable profile and the viewport-pinned footer. */
    .portfolio > :global(.profile) { max-height: calc(100dvh - 149px); overflow-y: auto; }
  }
  .projects { display: grid; gap: 48px; min-width: 0; scroll-margin-top: 50px; grid-column: 2; grid-row: 1; }
  @media (max-width: 1024px) {
    .portfolio { grid-template-columns: minmax(0, 1fr); }
    .projects { grid-column: 1; grid-row: auto; margin-top: 80px; }
  }

</style>
