<footer class="site-footer">
  <p>Москва, Россия · GMT/UTC+3<span data-moscow-clock hidden> · <time></time></span></p>
</footer>

<script>
  const clock = document.querySelector<HTMLElement>('[data-moscow-clock]');
  const time = clock?.querySelector('time');

  if (clock && time) {
    const formatter = new Intl.DateTimeFormat('ru-RU', {
      timeZone: 'Europe/Moscow',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    });

    const updateTime = () => {
      const now = new Date();
      time.textContent = formatter.format(now);
      time.dateTime = now.toISOString();
      clock.hidden = false;
    };

    updateTime();
    window.setInterval(updateTime, 60_000);
  }
</script>

<style>
  .site-footer { grid-column: 1; grid-row: 1; align-self: end; text-align: center; color: #747474; font-family: var(--font-ui); }
  .site-footer p { margin: 0; font-size: 16px; line-height: 19px; }
  @media (min-width: 1025px) {
    .site-footer {
      position: sticky;
      top: calc(100dvh - 50px - 19px);
      align-self: start;
    }
  }
  @media (max-width: 1024px) {
    .site-footer { grid-row: auto; margin-top: 64px; }
  }
</style>
