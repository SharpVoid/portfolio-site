---
interface Props { resumeHref?: string; wideTelegramLabel?: boolean; }
const { resumeHref = '/resume.pdf', wideTelegramLabel = false } = Astro.props;
---
<div class="contact-links">
  <a href={resumeHref} download="Михаил Лисенко Продуктовый дизайнер Резюме.pdf" data-resume-download><span aria-live="polite">Резюме</span></a>
  <button type="button" data-copy-email="lisenkomike.v@gmail.com"><span aria-live="polite">lisenkomike.v@gmail.com</span></button>
  <a href="https://t.me/sharpvoid" class:list={{ 'contact-links__telegram': wideTelegramLabel }}>{wideTelegramLabel ? <><span class="contact-links__telegram-wide">Telegram</span><span class="contact-links__telegram-handle">@sharpvoid</span></> : '@sharpvoid'}</a>
</div>
<style>
  .contact-links { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px; color: var(--color-accent); font-family: var(--font-sans); font-size: 16px; line-height: 20px; }
  .contact-links a { text-decoration: underline; text-underline-position: under; }
  .contact-links button { border: 0; padding: 0; background: none; color: inherit; font: inherit; cursor: pointer; transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1); }
  .contact-links button:active { transform: scale(1.1); transition-duration: 140ms; }
  .contact-links button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .contact-links__telegram-wide { display: none; }
  @media (min-width: 1680px) {
    .contact-links__telegram { order: -1; }
    .contact-links__telegram-wide { display: inline; }
    .contact-links__telegram-handle { display: none; }
  }
  .contact-links :is(a:not([data-resume-download]), button) { position: relative; text-decoration: none; }
  .contact-links :is(a:not([data-resume-download]), button)::after { content: ''; position: absolute; inset-inline: 0; bottom: -2px; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 250ms ease; }
  .contact-links :is(a:not([data-resume-download]), button):hover { opacity: 1; }
  .contact-links :is(a:not([data-resume-download]), button):hover::after, .contact-links :is(a:not([data-resume-download]), button):focus-visible::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .contact-links :is(a:not([data-resume-download]), button)::after, .contact-links button { transition: none; }
    .contact-links button:active { transform: none; }
  }
  @media (max-width: 600px) { .contact-links { flex-direction: column; align-items: center; gap: 28px; } }
</style>
<script>
  for (const link of document.querySelectorAll<HTMLElement>('[data-resume-download], [data-copy-email]')) {
    const label = link.querySelector('span');
    if (!label) continue;
    const email = link.dataset.copyEmail;
    let fadeTimer: number;
    let resetTimer: number;
    let restoreTimer: number;
    link.addEventListener('click', async () => {
      let feedback = 'Резюме ✓';
      if (email) {
        try {
          await navigator.clipboard.writeText(email);
          feedback = 'Почта скопирована <strong>✓</strong>';
        } catch {
          feedback = 'Не удалось скопировать';
        }
      }
      window.clearTimeout(fadeTimer);
      window.clearTimeout(resetTimer);
      window.clearTimeout(restoreTimer);
      const fade = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 150;
      label.style.transition = fade ? `opacity ${fade}ms ease` : 'none';
      label.style.opacity = '0';
      fadeTimer = window.setTimeout(() => {
        label.innerHTML = feedback;
        label.style.opacity = '1';
        resetTimer = window.setTimeout(() => {
          label.style.opacity = '0';
          restoreTimer = window.setTimeout(() => {
            label.textContent = email || 'Резюме';
            label.style.opacity = '1';
          }, fade);
        }, 1000);
      }, fade);
    });
  }
</script>
