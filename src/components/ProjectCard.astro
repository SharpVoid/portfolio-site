---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  title: string;
  description: string;
  image: ImageMetadata;
  mobileImage: ImageMetadata;
  alt: string;
  href?: string;
  priority?: boolean;
  secondary?: boolean;
  variants?: { image: ImageMetadata; media: string }[];
}
const { id, title, description, image, mobileImage, alt, href, priority = false, secondary = false, variants = [] } = Astro.props;
const crops = [{ image: mobileImage, media: '(max-width: 600px)' }, ...variants, { image, media: undefined }];
const sources = await Promise.all(crops.map(async (crop) => {
  // Keep enough source pixels for tall covers at 2x without shipping the 4K original.
  const width = Math.min(crop.image.width, Math.round(crop.image.width / crop.image.height * (crop.media === '(max-width: 600px)' ? 968 : 1320)));
  return {
    ...crop,
    avif: await getImage({ src: crop.image, format: 'avif', quality: 75, width }),
    webp: await getImage({ src: crop.image, format: 'webp', quality: 88, width }),
  };
}));
const fallback = sources.at(-1)!;
const Card = href ? 'a' : 'div';
---
<article id={id} class:list={['project-card', { 'project-card--secondary': secondary }]} aria-labelledby={`${id}-title`}>
  <Card class="project-card__link" href={href}>
    <picture class="project-card__media">
      {sources.map((source) => <>
        <source media={source.media} type="image/avif" srcset={source.avif.src} width={source.avif.attributes.width} height={source.avif.attributes.height} />
        <source media={source.media} type="image/webp" srcset={source.webp.src} width={source.webp.attributes.width} height={source.webp.attributes.height} />
      </>)}
      <img src={fallback.webp.src} width={fallback.webp.attributes.width} height={fallback.webp.attributes.height}
        alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
    </picture>
    <div class="project-card__content">
      <h2 id={`${id}-title`}>{title}</h2>
      <p>{description}</p>
    </div>
  </Card>
</article>
<style>
  .project-card { min-width: 0; scroll-margin-top: 50px; }
  .project-card__link { display: grid; gap: 18px; color: inherit; text-decoration: none; }
  .project-card__media { display: block; height: var(--cover-height); overflow: hidden; border-radius: 30px; }
  .project-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .project-card__content { display: grid; gap: 6px; }
  h2, p { margin: 0; font-size: 16px; line-height: 20px; }
  h2 { color: var(--color-accent); font-weight: 600; }
  a:hover h2 { text-decoration: underline; text-underline-offset: 3px; }
  .project-card--secondary .project-card__link { gap: 28px; }
  .project-card--secondary .project-card__media {
    box-shadow: 217px 137px 103px rgb(179 203 234 / 1%), 122px 77px 87px rgb(179 203 234 / 5%), 54px 34px 64px rgb(179 203 234 / 9%), 14px 9px 35px rgb(179 203 234 / 10%);
  }
  @media (max-width: 1024px) {
    .project-card__media { border-radius: 15px; }
  }
  @media (min-width: 901px) {
    h2 { font-size: 20px; line-height: 26px; }
    .project-card:not(.project-card--secondary) .project-card__media { height: 654px; }
    .project-card--secondary .project-card__link { gap: 18px; }
  }
  @media (max-width: 600px) {
    h2 { font-size: 20px; line-height: 26px; }
    p { text-wrap: balance; }
    .project-card--secondary .project-card__link { gap: 18px; }
    .project-card--secondary .project-card__media { box-shadow: none; }
  }
</style>
