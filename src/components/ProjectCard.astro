---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  title: string;
  description: string;
  image: ImageMetadata;
  mobileImage: ImageMetadata;
  alt: string;
  href?: string;
  video?: string;
  priority?: boolean;
  secondary?: boolean;
  variants?: { image: ImageMetadata; media: string }[];
}
const { id, title, description, image, mobileImage, alt, href, video, priority = false, secondary = false, variants = [] } = Astro.props;
const crops = [{ image: mobileImage, media: '(max-width: 600px)' }, ...variants, { image, media: undefined }];
const sources = await Promise.all(crops.map(async (crop) => {
  // Keep enough source pixels for tall covers at 2x without shipping the 4K original.
  const width = Math.min(crop.image.width, Math.round(crop.image.width / crop.image.height * (crop.media === '(max-width: 600px)' ? 968 : 1320)));
  return {
    ...crop,
    avif: await getImage({ src: crop.image, format: 'avif', quality: 75, width }),
    webp: await getImage({ src: crop.image, format: 'webp', quality: 88, width }),
  };
}));
const fallback = sources.at(-1)!;
const Card = href ? 'a' : 'div';
---
<article id={id} class:list={['project-card', { 'project-card--secondary': secondary }]} aria-labelledby={`${id}-title`}>
  <Card class="project-card__link" href={href}>
    <div class="project-card__media">
    <picture>
      {sources.map((source) => <>
        <source media={source.media} type="image/avif" srcset={source.avif.src} width={source.avif.attributes.width} height={source.avif.attributes.height} />
        <source media={source.media} type="image/webp" srcset={source.webp.src} width={source.webp.attributes.width} height={source.webp.attributes.height} />
      </>)}
      <img src={fallback.webp.src} width={fallback.webp.attributes.width} height={fallback.webp.attributes.height}
        alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
    </picture>
    {video && <video class="project-card__video" data-src={video} width={id === 'focusml' ? 1900 : id === 'atomreport' ? 1860 : 1920} height={id === 'focusml' ? 1100 : id === 'atomreport' ? 1112 : 1080} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>}
    </div>
    <div class="project-card__content">
      <h2 id={`${id}-title`}>{title}</h2>
      <p>{description}</p>
    </div>
  </Card>
  {video && <button class="project-card__playback" type="button" hidden aria-label={`Приостановить видео: ${title}`} data-title={title}>Ⅱ</button>}
</article>
<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.project-card__video')];
  const visible = new Set<HTMLVideoElement>();
  const stopped = new Set<HTMLVideoElement>();
  function update(video: HTMLVideoElement) {
    const button = video.closest('article')?.querySelector<HTMLButtonElement>('.project-card__playback');
    const shouldPlay = visible.has(video) && !stopped.has(video) && !motion.matches && !document.hidden;
    if (shouldPlay) {
      if (!video.getAttribute('src')) video.src = video.dataset.src!;
      video.muted = true;
      void video.play().catch(() => { video.classList.remove('is-playing'); });
    } else video.pause();
    if (motion.matches) video.classList.remove('is-playing');
    if (button) {
      button.hidden = motion.matches || !video.classList.contains('is-playing');
      button.textContent = stopped.has(video) ? '▶' : 'Ⅱ';
      button.setAttribute('aria-label', (stopped.has(video) ? 'Воспроизвести видео: ' : 'Приостановить видео: ') + button.dataset.title);
    }
  }
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) visible.add(video); else visible.delete(video);
      update(video);
    }
  }, { threshold: 0.05 });
  for (const video of videos) {
    const button = video.closest('article')?.querySelector<HTMLButtonElement>('.project-card__playback');
    video.addEventListener('playing', () => { video.classList.add('is-playing'); if (button) button.hidden = false; });
    video.addEventListener('error', () => { video.classList.remove('is-playing'); if (button) button.hidden = true; });
    button?.addEventListener('click', () => { if (stopped.has(video)) stopped.delete(video); else stopped.add(video); update(video); });
    observer.observe(video);
  }
  motion.addEventListener('change', () => videos.forEach(update));
  document.addEventListener('visibilitychange', () => videos.forEach(update));
</script>
<style>
  .project-card { position: relative; min-width: 0; scroll-margin-top: 50px; }
  .project-card__link { display: grid; gap: 18px; color: inherit; text-decoration: none; }
  .project-card__media { position: relative; display: block; height: var(--cover-height); overflow: hidden; border-radius: 30px; }
  .project-card__media picture { display: block; width: 100%; height: 100%; }
  .project-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .project-card__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; pointer-events: none; }
  .project-card__video.is-playing { opacity: 1; }
  .project-card__playback { position: absolute; top: 12px; right: 12px; border: 0; border-radius: 50%; width: 36px; height: 36px; background: rgb(0 0 0 / 55%); color: white; cursor: pointer; opacity: 0; }
  .project-card:hover .project-card__playback, .project-card__playback:focus-visible { opacity: 1; }
  @media (hover: none) { .project-card__playback { opacity: 1; } }
  @media (min-width: 601px) and (max-width: 900px), (min-width: 1025px) and (max-width: 1679px) { #focusml .project-card__video { object-position: 10% center; } }
  @media (max-width: 600px) { #focusml .project-card__video { object-position: 42% center; } }
  .project-card__content { display: grid; gap: 6px; }
  h2, p { margin: 0; font-size: 16px; line-height: 20px; }
  h2 { color: var(--color-accent); font-weight: 600; }
  a:hover h2 { text-decoration: underline; text-underline-offset: 3px; }
  .project-card--secondary .project-card__media {
    box-shadow: 217px 137px 103px rgb(179 203 234 / 1%), 122px 77px 87px rgb(179 203 234 / 5%), 54px 34px 64px rgb(179 203 234 / 9%), 14px 9px 35px rgb(179 203 234 / 10%);
  }
  @media (max-width: 1024px) {
    .project-card__media { border-radius: 15px; }
  }
  @media (min-width: 1680px) {
    h2 { font-size: 20px; line-height: 26px; }
    .project-card:not(.project-card--secondary) .project-card__media { height: 654px; }
  }
  @media (max-width: 600px) {
    h2 { font-size: 20px; line-height: 26px; }
    p { text-wrap: balance; }
    .project-card--secondary .project-card__media { box-shadow: none; }
  }
</style>
