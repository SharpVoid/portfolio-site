---
import CaseMedia from './CaseMedia.astro';
import type { CaseMediaData } from './types';
interface Props { title: string; intro: string; tags: string[]; media: CaseMediaData; }
const { title, intro, tags, media } = Astro.props;
---
<header class="case-hero case-shell">
      <div class="case-hero__media">
        <CaseMedia media={media} hero />
      </div>

      <div class="case-hero__copy">
        <h1>{title}</h1>
        <p>{intro}</p>
      </div>
      <div class="case-tags" data-tags>
        {tags.map((tag, index) => <span class:list={['case-tag', { 'case-tag--extra': index > 1 }]} style={`--tag-delay: ${Math.max(0, index - 2) * 50}ms`}>{tag}</span>)}
        {tags.length > 2 && <button class="case-tag case-tags__toggle" type="button" aria-expanded="false" aria-label={`Показать ещё ${tags.length - 2} направления`} data-extra-count={tags.length - 2}>+{tags.length - 2}</button>}
      </div>
    </header>
