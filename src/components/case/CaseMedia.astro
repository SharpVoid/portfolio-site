---
import { Image } from 'astro:assets';
import type { CaseMediaData } from './types';
interface Props {
  media: CaseMediaData;
  hero?: boolean;
  loading?: 'eager' | 'lazy';
}
const { media, hero = false, loading = 'lazy' } = Astro.props;
// Cover crops need pixels for the full image width, including the part outside the frame.
const ratio = media.image ? media.image.width / media.image.height : 1;
const heroSizes = `(max-width: 600px) max(calc(100vw - 62px), ${337 * ratio}px), (max-width: 1024px) max(calc(100vw - 62px), ${538 * ratio}px), (max-width: 1100px) max(calc(66.346vw + 282.62px), ${538 * ratio}px), (max-width: 1440px) max(calc(66.346vw + 282.62px), ${634 * ratio}px), (max-width: 1526px) max(calc(100vw - 202px), ${634 * ratio}px), ${Math.max(1324, 634 * ratio)}px`;
---
{media.image ? (
  <Image src={media.image} alt={media.alt} quality={90} loading={hero ? 'eager' : loading}
    widths={hero ? [...new Set([640, 960, 1326, 2080, 2652, media.image.width].filter(width => width <= media.image.width))] : undefined}
    sizes={hero ? heroSizes : undefined}
    fetchpriority={hero ? 'high' : undefined}
    style={hero && media.objectPosition ? `--case-hero-mobile-position: ${media.objectPosition}` : undefined}
    data-media-bordered={!hero || media.bordered || undefined}
    data-media-desktop-hug={media.desktopHug || undefined}
    data-image-preview={hero ? undefined : media.image.src}
    role={hero ? undefined : 'button'} tabindex={hero ? undefined : '0'} aria-haspopup={hero ? undefined : 'dialog'} />
) : (
  <video poster={media.poster} data-case-video data-title={media.alt}
    data-square={media.square || undefined}
    style={media.objectPosition ? `object-position: ${media.objectPosition}` : undefined}
    autoplay muted loop playsinline preload={hero ? 'metadata' : 'none'}
    role="button" tabindex="0" aria-label={`Приостановить видео: ${media.alt}`}>
    {media.webm && <source data-src={media.webm} type="video/webm" />}
    <source data-src={media.video} type="video/mp4" />
  </video>
)}
